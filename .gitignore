# This file is used to ignore files which are generated
# ----------------------------------------------------------------------------

*~
*.autosave
*.a
*.core
*.moc
*.o
*.obj
*.orig
*.rej
*.so
*.so.*
*_pch.h.cpp
*_resource.rc
*.qm
.#*
*.*#
core
!core/
tags
.DS_Store
.directory
*.debug
Makefile*
*.prl
*.app
moc_*.cpp
ui_*.h
qrc_*.cpp
Thumbs.db
*.res
*.rc
aqtinstall.log
# Hand-authored Windows resource script (icon + version info), required by the
# desktop build — keep it tracked despite the blanket *.rc ignore above.
!assets/app.rc
/.qmake.cache
/.qmake.stash

# qtcreator generated files
*.pro.user*
*.qbs.user*
CMakeLists.txt.user*
*.ts

# xemacs temporary files
*.flc

# Vim temporary files
.*.swp

# Visual Studio generated files
*.ib_pdb_index
*.idb
*.ilk
*.pdb
*.sln
*.suo
*.vcproj
*vcproj.*.*.user
*.ncb
*.sdf
*.opensdf
*.vcxproj
*vcxproj.*

# CLion / JetBrains generated files
# Ignore the noisy per-user/IDE state under .idea but keep intentionally
# shared project files (e.g. .idea/QtSettings.xml) by force-adding them.
.idea/
*.iml
cmake-build-*/
# "Inspect Code" exports its report as ~40 MB of XML into ./clang-tidy.
/clang-tidy/

# MinGW generated files
*.Debug
*.Release

# Python
*.pyc
__pycache__/

# Binaries
# --------
*.dll
*.exe

# Directories with generated files
.moc/
.obj/
.pch/
.rcc/
.uic/
build/
/venv/
/staging/
/dist/
# Local Claude Code state stays out; the shared project skills are tracked.
# (Excluding the directory itself would make the negation below unreachable.)
/.claude/*
!/.claude/skills/
/ai_context/
.vscode/
.clang-format
CMakeUserPresets.json
.run/
.trunk/

# Android build artifacts (most live under build/, but Gradle/Qt deploy
# can spill into the project root and signing material must never land
# in the repo).
*.apk
*.aab
*.keystore
*.jks
local.properties
.gradle/

#secret — the filled-in file never lands in the repo, the template always does.
secrets/*
!secrets/api_keys.env.example