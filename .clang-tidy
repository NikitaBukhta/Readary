---
# Strict static-analysis profile. Enabled by ENABLE_ANALYZE in CMake.
# Skip via `python bootstrap.py compile --skip-analyze` for one-off builds.

Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-braces-around-statements,
  -readability-implicit-bool-conversion,
  -readability-redundant-access-specifiers,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-static-cast-downcast,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-avoid-c-arrays,
  -modernize-avoid-c-arrays,
  -bugprone-easily-swappable-parameters,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -misc-include-cleaner,
  -modernize-use-nodiscard,
  -cert-err58-cpp,
  -cppcoreguidelines-avoid-do-while,
  -misc-confusable-identifiers

WarningsAsErrors: '*'

# Only report findings from our own source tree. Excludes Qt SDK headers,
# vcpkg-installed deps, and the build directory (MOC/QRC generated code).
HeaderFilterRegex: '^.*[/\\]src[/\\](?!.*[/\\]build[/\\]).*$'

FormatStyle: file

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: '30'
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: '_'
  - key: readability-identifier-naming.GlobalVariablePrefix
    value: 'g_'
  # Local consts and members follow normal variable casing (camelBack);
  # global constants (CamelCase) are deliberately unconstrained — let the
  # author pick the convention (`kSearchRoles`, `SearchRoles`, etc.).
  - key: readability-identifier-naming.LocalConstantCase
    value: camelBack
  - key: readability-identifier-naming.LocalConstantPointerCase
    value: camelBack
  - key: readability-identifier-naming.ConstantParameterCase
    value: camelBack
  - key: readability-identifier-naming.ConstantMemberCase
    value: camelBack
  - key: readability-identifier-naming.ClassConstantCase
    value: camelBack
  - key: modernize-use-default-member-init.UseAssignment
    value: 'true'
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: 'true'
  - key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions
    value: 'true'
  - key: bugprone-unused-local-non-trivial-variable.IncludeTypes
    value: '::Q.*;.*Model.*;.*Controller.*'
