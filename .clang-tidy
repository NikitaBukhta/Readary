---
# Strict static-analysis profile. Enabled by ENABLE_ANALYZE in CMake.
# Skip via `python bootstrap.py compile --skip-analyze` for one-off builds.
#
# The google-* family encodes the Google C++ Style Guide. Two of its checks are
# switched off below (the Checks block is a YAML folded scalar, so the reasons
# can't live inline):
#   google-default-arguments — QAbstractItemModel declares rowCount()/data()
#     as virtual *with* defaults, so every model override inherits the pattern.
#     Our overrides repeat the base's own default values, which means the
#     "caller through a base pointer silently gets a different default" hazard
#     the check guards against cannot occur here.
#   google-readability-braces-around-statements — alias of the already-disabled
#     readability-braces-around-statements; clang-format's InsertBraces owns
#     brace placement now, so the check would only duplicate its work.
# google-build-using-namespace IS enabled: use per-operator using-declarations
# (`using Qt::StringLiterals::operator""_s;`) rather than a using-directive.

Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  google-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-braces-around-statements,
  -readability-implicit-bool-conversion,
  -readability-redundant-access-specifiers,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-static-cast-downcast,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-avoid-c-arrays,
  -modernize-avoid-c-arrays,
  -bugprone-easily-swappable-parameters,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -misc-include-cleaner,
  -modernize-use-nodiscard,
  -cert-err58-cpp,
  -cppcoreguidelines-avoid-do-while,
  -misc-confusable-identifiers,
  -google-default-arguments,
  -google-readability-braces-around-statements

WarningsAsErrors: '*'

# Only report findings from our own source tree. Excludes Qt SDK headers,
# vcpkg-installed deps, and the build directory (MOC/QRC generated code).
HeaderFilterRegex: '^.*[/\\]src[/\\](?!.*[/\\]build[/\\]).*$'

FormatStyle: file

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: '30'
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: '_'
  - key: readability-identifier-naming.GlobalVariablePrefix
    value: 'g_'
  # Local consts and members follow normal variable casing (camelBack);
  # global constants (CamelCase) are deliberately unconstrained — let the
  # author pick the convention (`kSearchRoles`, `SearchRoles`, etc.).
  - key: readability-identifier-naming.LocalConstantCase
    value: camelBack
  - key: readability-identifier-naming.LocalConstantPointerCase
    value: camelBack
  - key: readability-identifier-naming.ConstantParameterCase
    value: camelBack
  - key: readability-identifier-naming.ConstantMemberCase
    value: camelBack
  - key: readability-identifier-naming.ClassConstantCase
    value: camelBack
  - key: modernize-use-default-member-init.UseAssignment
    value: 'true'
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: 'true'
  - key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions
    value: 'true'
  - key: bugprone-unused-local-non-trivial-variable.IncludeTypes
    value: '::Q.*;.*Model.*;.*Controller.*'
  # RAII scope-guards are "unused" by design — the ::Q.* include above would
  # otherwise flag them. ExcludeTypes takes precedence over IncludeTypes.
  - key: bugprone-unused-local-non-trivial-variable.ExcludeTypes
    value: '.*QMutexLocker.*;.*QReadLocker.*;.*QWriteLocker.*;.*QSignalBlocker.*;.*QScopedValueRollback.*'
